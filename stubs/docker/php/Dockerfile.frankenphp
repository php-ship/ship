# FrankenPHP has its own base image (Debian + Caddy + embedded PHP), so this
# mirrors stubs/docker/php/Dockerfile's dev/builder/prod stage structure but
# can't share it — see OctaneFrankenPhpService's docblock for why. Image tag
# format and the bundled install-php-extensions script are both confirmed
# against FrankenPHP's own docs (frankenphp.dev/docs/docker), not guessed.

ARG PHP_VERSION=8.4
ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS node

FROM dunglas/frankenphp:1-php${PHP_VERSION}-bookworm AS base

# pdo_pgsql/pdo_mysql/redis/pcntl are all unconditional, same as the main
# Dockerfile -- see that file's comment for why.
RUN install-php-extensions pdo_pgsql pdo_mysql intl mbstring opcache redis pcntl

# Copied from the official node image at the pinned NODE_VERSION -- glibc-built (matches this
# Debian bookworm base, unlike the main Dockerfile's musl/Alpine node image), not installed via
# `apt-get install nodejs npm`, for the same reason the main Dockerfile doesn't: the OS package
# repo only ever carries one fixed Node version, independent of NODE_VERSION. See that file's
# comment on the npm symlinks -- identical reasoning, duplicated here since the base images
# (and therefore the exact node image variant needed) differ.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /var/www/html

# ---- dev -------------------------------------------------------------
FROM base AS dev
RUN install-php-extensions xdebug
COPY ship/dev/php.ini /usr/local/etc/php/conf.d/99-ship-dev.ini
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY ship/dev/entrypoint.sh /usr/local/bin/ship-entrypoint
RUN chmod +x /usr/local/bin/ship-entrypoint
ENTRYPOINT ["/usr/local/bin/ship-entrypoint"]
# No CMD here: FrankenPHP's default CMD from its base image would start
# Caddy directly off a Caddyfile, but Octane manages FrankenPHP itself via
# `php artisan octane:start --server=frankenphp` -- that's what
# OctaneFrankenPhpService sets as the compose-level `command:`, which
# becomes this ENTRYPOINT's "$@" regardless of what CMD would have been.

# ---- builder -----------------------------------------------------------
FROM base AS builder
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --optimize-autoloader
COPY . .
RUN composer dump-autoload --optimize --no-dev

# ---- assets --------------------------------------------------------------
# See stubs/docker/php/Dockerfile's "assets" stage -- identical reasoning,
# duplicated here rather than shared since this Dockerfile can't FROM the
# other one (different base images entirely).
FROM builder AS assets
RUN if [ -f package.json ]; then \
        (npm ci || npm install) && npm run build; \
    fi

# ---- prod --------------------------------------------------------------
FROM base AS prod
COPY ship/prod/php.ini /usr/local/etc/php/conf.d/99-ship-prod.ini
COPY --from=assets /var/www/html /var/www/html
# See stubs/docker/php/Dockerfile's matching entrypoint wiring -- same
# generated-not-static file, same reasoning.
COPY ship/prod/entrypoint.sh /usr/local/bin/ship-entrypoint
RUN chmod +x /usr/local/bin/ship-entrypoint
ENTRYPOINT ["/usr/local/bin/ship-entrypoint"]

# KNOWN GAP: the base dunglas/frankenphp image ships a HEALTHCHECK against
# Caddy's admin metrics endpoint (localhost:2019/metrics). That's correct
# when FrankenPHP runs as its own Caddy-driven process, but Octane instead
# manages FrankenPHP through the PHP extension embedded in this image, not
# by running the binary against a Caddyfile — so that inherited healthcheck
# may not reflect what's actually running. Not fixed here; flagging rather
# than silently inheriting a healthcheck that might be meaningless.
