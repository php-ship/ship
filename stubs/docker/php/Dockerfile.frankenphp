# FrankenPHP has its own base image (Debian + Caddy + embedded PHP), so this mirrors the
# dev/builder/assets/prod stages of stubs/docker/php/Dockerfile without sharing it.

ARG PHP_VERSION=8.4
ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS node

FROM dunglas/frankenphp:1-php${PHP_VERSION}-bookworm AS base

# The same unconditional extension set as the main Dockerfile, with redis pinned the same way.
ARG REDIS_EXTENSION_VERSION=6.3.0
RUN install-php-extensions pdo_pgsql pdo_mysql intl mbstring opcache redis-$REDIS_EXTENSION_VERSION pcntl

# ship.json's phpExtensions. install-php-extensions is already in this base image.
ARG PHP_EXTENSIONS=""
RUN if [ -n "$PHP_EXTENSIONS" ]; then install-php-extensions $PHP_EXTENSIONS; fi

# The base image has neither ext-zip nor unzip, which Composer needs to extract packages.
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*

# Copied from the official node image at NODE_VERSION (glibc-built, matching this Debian base),
# as in the main Dockerfile.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /var/www/html

# ---- dev -------------------------------------------------------------
FROM base AS dev
# Pinned to an exact release, as in the main Dockerfile.
ARG XDEBUG_EXTENSION_VERSION=3.5.3
RUN install-php-extensions xdebug-$XDEBUG_EXTENSION_VERSION
COPY ship/dev/php.ini /usr/local/etc/php/conf.d/99-ship-dev.ini
COPY --from=composer:2.10.3 /usr/bin/composer /usr/bin/composer
COPY ship/dev/entrypoint.sh /usr/local/bin/ship-entrypoint
RUN chmod +x /usr/local/bin/ship-entrypoint
# ship.json's hostUser (opt-in): see the matching block in stubs/docker/php/Dockerfile. Uses
# Debian's useradd/groupadd. "www-data" (33:33) already exists here, so a host UID of 33 reuses
# it. HOST_UID stays 0 unless it's set.
ARG HOST_UID=0
ARG HOST_GID=0
RUN if [ "$HOST_UID" != "0" ]; then \
        group=$(getent group "$HOST_GID" | cut -d: -f1); \
        [ -n "$group" ] || { groupadd -g "$HOST_GID" ship && group=ship; }; \
        user=$(getent passwd "$HOST_UID" | cut -d: -f1); \
        [ -n "$user" ] || { useradd -u "$HOST_UID" -g "$group" -M ship && user=ship; }; \
        mkdir -p /home/ship && chown "$HOST_UID:$HOST_GID" /home/ship; \
    fi
# Caddy's state/certificate directories must be writable by whoever FrankenPHP runs as. A no-op
# when HOST_UID is unset (already root-owned).
RUN chown -R "$HOST_UID:$HOST_GID" /data/caddy /config/caddy
ENTRYPOINT ["/usr/local/bin/ship-entrypoint"]
# No CMD: Octane manages FrankenPHP itself via `php artisan octane:start --server=frankenphp`,
# which OctaneFrankenPhpService sets as the compose `command:`.

# ---- builder -----------------------------------------------------------
FROM base AS builder
COPY --from=composer:2.10.3 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --optimize-autoloader
COPY . .
RUN composer dump-autoload --optimize --no-dev

# ---- assets --------------------------------------------------------------
# See the "assets" stage in stubs/docker/php/Dockerfile.
FROM builder AS assets
RUN if [ -f package.json ]; then \
        if [ -f package-lock.json ]; then npm ci; else npm install; fi \
        && npm run build \
        && rm -rf node_modules; \
    fi

# ---- prod --------------------------------------------------------------
FROM base AS prod
COPY ship/prod/php.ini /usr/local/etc/php/conf.d/99-ship-prod.ini
COPY --from=assets /var/www/html /var/www/html
# The generated entrypoint: see stubs/docker/php/Dockerfile.
COPY ship/prod/entrypoint.sh /usr/local/bin/ship-entrypoint
RUN chmod +x /usr/local/bin/ship-entrypoint
# OctaneFrankenPhpService sets SHIP_RUN_AS=www-data and the entrypoint drops to it, so Caddy's
# state/certificate directories must be writable by www-data.
RUN chown -R www-data:www-data /data/caddy /config/caddy
ENTRYPOINT ["/usr/local/bin/ship-entrypoint"]

# Disables the base image's HEALTHCHECK (Caddy's admin /metrics endpoint): it reports whether
# Caddy is alive, not whether the PHP worker can serve requests, so a broken app would still read
# "healthy". No Octane runtime has a healthcheck.
HEALTHCHECK NONE
